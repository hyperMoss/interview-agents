{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM"], "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noUncheckedIndexedAccess": true, "esModuleInterop": true, "skipLibCheck": true,
    "experimentalDecorators": true, "emitDecoratorMetadata": true, "jsx": "react-jsx", "resolveJsonModule": true, "noEmit": true,
    "types": ["node", "vite/client"]
  },
  "include": ["apps", "packages", "scripts", "tests", "*.ts"]
}
