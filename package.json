{
  "name": "interview-agents",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.6",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.15",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "bun": "^1.3.10",
    "concurrently": "^9.2.1",
    "esbuild": "^0.25.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "dev": "pnpm factory:check && concurrently -k -n api,agent,worker,web \"pnpm dev:api\" \"pnpm dev:agent\" \"pnpm dev:worker\" \"pnpm dev:web\"",
    "dev:api": "node --import tsx --watch --env-file=.env apps/api/src/main.ts",
    "dev:agent": "bun --env-file=.env --watch apps/agent/src/main.ts",
    "dev:worker": "node --import tsx --watch --env-file=.env apps/worker/src/main.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "build": "pnpm factory:check && pnpm typecheck && vite build --config apps/web/vite.config.ts && pnpm skill:bundle && pnpm skill:validate",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "node --import tsx --env-file=.env scripts/migrate.ts",
    "factory": "node --import tsx packages/factory/src/cli.ts",
    "factory:docs": "pnpm factory docs --spec app.spec.yaml --output .",
    "skill:bundle": "node scripts/bundle-skill.mjs",
    "verify": "pnpm build && pnpm test",
    "runtime:setup": "node node_modules/bun/install.js",
    "factory:check": "node --import tsx scripts/check-runtime.ts",
    "skill:validate": "node scripts/validate-skill.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "2.0.62",
    "@mastra/core": "1.76.0",
    "@mastra/hono": "1.7.18",
    "@mastra/pg": "^1.31.0",
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@tanstack/react-query": "^5.90.0",
    "@types/multer": "2.0.0",
    "bullmq": "^5.61.0",
    "drizzle-orm": "^0.44.5",
    "express": "5.1.0",
    "hono": "^4.9.8",
    "mammoth": "1.11.0",
    "multer": "2.0.2",
    "pdf-parse": "2.4.5",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "yaml": "^2.8.1",
    "zod": "^4.1.11"
  },
  "packageManager": "pnpm@12.11.2"
}
