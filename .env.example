NODE_ENV=development
API_PORT=3000
AGENT_PORT=4111
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://app:local-app-password@localhost:55439/interview
AGENT_DATABASE_URL=postgresql://agent:local-agent-password@localhost:55439/interview
REDIS_URL=redis://localhost:56389
AGENT_URL=http://127.0.0.1:4111
INTERNAL_SERVICE_TOKEN=local-only-change-before-deploy-123456
COOKIE_SECRET=local-only-cookie-secret-change-123456
MODEL_MODE=demo
# Production: live for a deployment model, disabled for BYOK-only; HTTPS and unique secrets are required.
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
# Custom models: auto enables in local development, disables in production.
CUSTOM_MODELS=auto
ALLOW_LOCAL_MODELS=auto
# Production custom access requires an explicit hostname allowlist.
MODEL_ALLOWED_HOSTS=
# Search settings are held by Agent; production needs an explicit hostname allowlist.
SEARCH_ACCESS=auto
ALLOW_LOCAL_SEARCH=auto
SEARCH_ALLOWED_HOSTS=
